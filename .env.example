# Familieassistenten — eksempel på miljøvariabler
#
# Kopier til .env og fyll inn verdier:
#   cp .env.example .env
#   chmod 600 .env
#   chown pi:pi .env
#
# Alle felter valideres av Zod i server/config.js ved oppstart.
# Feil format → serveren nekter å starte med en tydelig feilmelding.

# ============================================================
# Kjerne
# ============================================================

# HTTP-port. Default 3000.
PORT=3000

# 'production' krever AUTH_TOKEN og en konkret ALLOWED_ORIGINS.
# 'development' bruker pretty-log + tillater * for CORS.
# 'test' brukes automatisk av `node --test`.
NODE_ENV=production

# ============================================================
# Autentisering (PÅKREVD i production)
# ============================================================

# Bearer token for /api/*-endepunkter. Min 16 tegn, helst 32+.
# Generer: openssl rand -hex 32
AUTH_TOKEN=

# Komma-separert liste over tillatte origins. '*' er forbudt i prod.
# Eksempel: https://familieassistenten.local,https://raspberrypi.local
ALLOWED_ORIGINS=https://familieassistenten.local

# Sett til 'true' når serveren kjører bak Caddy/nginx med HTTPS.
# Aktiverer Strict-Transport-Security-header.
HTTPS_TERMINATED=false

# ============================================================
# HTTP + sikkerhet
# ============================================================

# Maks request body-størrelse (bytes). Default 1 MB.
MAX_BODY_BYTES=1048576

# Rate limit per IP (sliding window).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ============================================================
# Database
# ============================================================

# Full sti til SQLite-filen. Default: ./data/familieassistenten.db
# DB_PATH=/home/pi/Familieassistenten/data/familieassistenten.db

# ============================================================
# Backup
# ============================================================

# Daglig backup kjøres kl BACKUP_HOUR:00 (0–23). Default 3.
BACKUP_HOUR=3

# Hvor mange backups som beholdes før prune. Default 14.
BACKUP_KEEP_DAYS=14

# Off-site backup — tre alternativer:
#   1. Lokal/NAS-mount:  /mnt/nas/familieassistenten
#   2. SSH host:         pi@nas.local:/mnt/backups/familieassistenten
#   3. rsync daemon:     rsync://host/module/path
# Feiler aldri lokal backup — bare logged + alert via ALERT_WEBHOOK.
# BACKUP_REMOTE_PATH=
# BACKUP_REMOTE_TIMEOUT_MS=60000

# ============================================================
# LLM (Ollama / llama.cpp)
# ============================================================

# 'ollama' eller 'llamacpp'. Default ollama.
LLM_BACKEND=ollama

# Ollama-host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Modell-navn. qwen2.5:3b er beste balanse for 8GB RPi5.
OLLAMA_MODEL=qwen2.5:3b

# Alternativ: llama.cpp server
LLAMACPP_HOST=http://localhost:8080

# Kontekst-vindu (tokens). Hold under modellens maks.
MAX_CONTEXT_TOKENS=3072

# ============================================================
# STT (Whisper)
# ============================================================

# 'whisper_cpp' eller tomt (bruker browser Web Speech API)
# STT_BACKEND=whisper_cpp
# WHISPER_CPP_PATH=/opt/whisper.cpp/main
# WHISPER_MODEL_PATH=/opt/whisper.cpp/models/ggml-nb-whisper-base.bin
# WHISPER_THREADS=3

# ============================================================
# API-nøkler (alternative LLM-backends)
# ============================================================
# Disse lagres via Settings-UI → env-store.service. Kan også settes her
# for bootstrap. Hold filen på 0600 så de ikke lekkes.

# KASSAL_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# ============================================================
# Observability (M4)
# ============================================================

# Pino log-level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Pretty-printed logger i dev (ignoreres ellers)
LOG_PRETTY=false

# Webhook for alerts (fatal exceptions, backup-feil, breaker OPEN).
# Kompatibel med Discord/Slack/ntfy/custom. Tom = disabled.
# ALERT_WEBHOOK=https://discord.com/api/webhooks/.../slack
# ALERT_THROTTLE_MS=900000  # 15 minutter per nøkkel
