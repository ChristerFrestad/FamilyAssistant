# FamilyAssistant — environment variable example
#
# Copy to .env and fill in values:
#   cp .env.example .env
#   chmod 600 .env
#   chown pi:pi .env
#
# All fields are validated by Zod in server/config.js at startup.
# Wrong format → the server refuses to start with a clear error message.

# ============================================================
# White-label (optional)
# ============================================================

# White-label override. Default app name is "FamilyAssistant" in all
# languages. Set VITE_APP_NAME (frontend, build-time) and APP_NAME
# (backend, runtime) to the same value to swap out the product name.
# Both must be set — frontend reads its own, backend reads its own, and
# they should match. See AGENTS.md PART 7.12 for the full policy.
#
# Example:
#   VITE_APP_NAME=Husby
#   APP_NAME=Husby
VITE_APP_NAME=
APP_NAME=

# ============================================================
# Core
# ============================================================

# HTTP port. Default 7777 — matches Dockerfile, docker-compose.yml,
# Vite proxy in client/vite.config.ts, and the port-matrix in
# AGENTS.md DEL 7.8.
PORT=7777

# 'production' requires AUTH_TOKEN and a concrete ALLOWED_ORIGINS.
# 'development' uses pretty-log + allows * for CORS.
# 'test' is used automatically by `node --test`.
NODE_ENV=production

# ============================================================
# Authentication (REQUIRED in production)
# ============================================================

# --- AUTH_TOKEN: the actual secret for /api/* endpoints ---
# Min 16 characters, preferably 32+. Generate with: openssl rand -hex 32
# NOTE: this is no longer the same as AUTH_TOKEN_CREATED_AT further down.
#
# Docker deploy via Portainer or `docker compose up`: you CAN leave this
# blank. The first time the server starts without AUTH_TOKEN it will run a
# setup wizard at http://<host>:7777/setup.html that generates and stores
# the value in /app/data/bootstrap.json. Later restarts read from there.
AUTH_TOKEN=

# Comma-separated list of allowed origins. '*' is forbidden in prod.
# Example: https://familieassistenten.local,https://raspberrypi.local
# Can also be set in the setup wizard on first Docker deploy.
ALLOWED_ORIGINS=https://familyassistant.local

# Set to 'true' when the server runs behind Caddy/nginx with HTTPS.
# Enables the Strict-Transport-Security header.
HTTPS_TERMINATED=false

# --- Rotation tracking (optional, NOT the token itself) ---
# AUTH_TOKEN_CREATED_AT: ISO-8601 timestamp for the last rotation of the
# token above. The /ready endpoint flags a warning when more than
# AUTH_TOKEN_MAX_AGE_DAYS days have passed since rotation. Set manually
# after each rotation.
# AUTH_TOKEN_CREATED_AT=2026-04-18T00:00:00Z
# AUTH_TOKEN_MAX_AGE_DAYS=90

# --- Docker bootstrap wizard (phase 22) ---
# Automatically set to "true" by docker-compose.yml. Enables the setup flow
# at /setup.html on the first deploy without AUTH_TOKEN. Do not set this in
# bare-metal/systemd deploys — there a missing AUTH_TOKEN is an error, not
# a first-time deploy.
# BOOTSTRAP_ALLOWED=false

# ============================================================
# HTTP + security
# ============================================================

# Max request body size (bytes). Default 1 MB.
MAX_BODY_BYTES=1048576

# Rate limit per IP (sliding window).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ============================================================
# Database
# ============================================================

# Full path to the SQLite file. Default: ./data/familieassistenten.db
# DB_PATH=/home/pi/FamilyAssistant/data/familieassistenten.db

# ============================================================
# Backup
# ============================================================

# Daily backup runs at BACKUP_HOUR:00 (0–23). Default 3.
BACKUP_HOUR=3

# How many backups are kept before pruning. Default 14.
BACKUP_KEEP_DAYS=14

# Off-site backup — three options:
#   1. Local/NAS mount:  /mnt/nas/familieassistenten
#   2. SSH host:         pi@nas.local:/mnt/backups/familieassistenten
#   3. rsync daemon:     rsync://host/module/path
# Local backup never fails — just logged + alerted via ALERT_WEBHOOK.
# BACKUP_REMOTE_PATH=
# BACKUP_REMOTE_TIMEOUT_MS=60000

# ============================================================
# LLM (Ollama / llama.cpp)
# ============================================================

# 'ollama' or 'llamacpp'. Default ollama.
LLM_BACKEND=ollama

# Ollama host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Model name. qwen2.5:3b is the best balance for an 8GB RPi5.
OLLAMA_MODEL=qwen2.5:3b

# Alternative: llama.cpp server
LLAMACPP_HOST=http://localhost:8080

# Context window (tokens). Keep below the model's maximum.
MAX_CONTEXT_TOKENS=3072

# ============================================================
# STT (Whisper)
# ============================================================

# 'whisper_cpp' or empty (uses browser Web Speech API)
# STT_BACKEND=whisper_cpp
# WHISPER_CPP_PATH=/opt/whisper.cpp/main
# WHISPER_MODEL_PATH=/opt/whisper.cpp/models/ggml-nb-whisper-base.bin
# WHISPER_THREADS=3

# ============================================================
# API keys (alternative LLM backends)
# ============================================================
# These are stored via the Settings UI → env-store.service. Can also be set
# here for bootstrap. Keep the file at 0600 so they don't leak.

# KASSAL_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# ============================================================
# Observability (M4)
# ============================================================

# Pino log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Pretty-printed logger in dev (ignored otherwise)
LOG_PRETTY=false

# Webhook for alerts (fatal exceptions, backup failures, breaker OPEN).
# Compatible with Discord/Slack/ntfy/custom. Empty = disabled.
# ALERT_WEBHOOK=https://discord.com/api/webhooks/.../slack
# ALERT_THROTTLE_MS=900000  # 15 minutes per key

# ============================================================
# Multi-tenant auth (RPi5 and cloud deploy)
# ============================================================
# Week 2 enables multi-tenant on RPi5 self-host as well. AUTH_TOKEN +
# synthetic LOCAL_USER continue to work for the original pilot family;
# new families get real sessions via magic link or Google OAuth.

# Absolute URL to your instance, without trailing slash. Used in magic-link
# emails and as the Google OAuth redirect base.
# APP_URL=https://appdomain.com

# 32 bytes hex, signs session cookies and OAuth state.
#
# Docker/Portainer deploy: leave this blank. The first time the server
# starts the value is generated and stored in /app/data/bootstrap.json
# (alongside AUTH_TOKEN from the setup wizard). Upgrade from older
# bootstrap.json without sessionSecret: the value is self-healed in
# automatically on the next restart. Later you can override by setting
# SESSION_SECRET here.
#
# Bare-metal/systemd deploy: generate manually with "openssl rand -hex 32"
# and set here. Do not change at runtime — all sessions will be invalidated.
# SESSION_SECRET=

# 32 bytes hex, AES-256-GCM encrypts stored LLM API keys.
# Never the same as SESSION_SECRET.
# openssl rand -hex 32
# ENCRYPTION_KEY=

# Google OAuth — register your app in the Google Cloud Console and set the
# redirect URI to ${APP_URL}/api/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Magic-link email via Resend. Requires a verified sender domain
# (SPF + DKIM in DNS at your registrar). FROM must be on a verified domain.
# RESEND_API_KEY=
# RESEND_FROM=noreply@appdomain.com

# Pilot/MVP mode: if Resend is NOT configured and this is true, the server
# logs the magic-link URL to stdout instead of returning 503. The operator
# copies the URL from the container log (Portainer / docker logs) and
# pastes it into the browser. No email service required. Turn off (set to
# false or remove) as soon as Resend or another mailer is in place.
# MAGIC_LINK_CONSOLE=false

# ============================================================
# Password auth (username/password) + progressive email verify
# ============================================================
# Low barrier: register with username + password and use the app
# immediately. Email verification via magic link is optional during
# a grace window (default 60 days from account creation). After the
# window, the next login requires email verification AND a new
# password (reset). Tune the grace for pilot/test e.g. 86400 (24h)
# or 3600 (1h).
# PASSWORD_AUTH_ENABLED=true
# PASSWORD_AUTH_OPEN_REGISTER=true
# EMAIL_VERIFICATION_GRACE_SECONDS=5184000

# ============================================================
# Pilot / MVP self-test bypass
# ============================================================
# When PILOT_BYPASS=true the server exposes GET /api/auth/pilot-login
# which creates a local pilot user (pilot@local) and sets a session
# without magic link or OAuth. The login page then shows a "Jump in as
# pilot" button that does the same thing with one click.
#
# WARNING: This disables all auth. Anyone who can reach the server can log
# in as the pilot user. Only for single-user MVP testing — turn off
# BEFORE more people get access to the deploy.
#
# In NODE_ENV=production the server refuses to start with PILOT_BYPASS=true
# unless PILOT_BYPASS_PRODUCTION_ACK=true is also set.
# PILOT_BYPASS=false
# PILOT_BYPASS_PRODUCTION_ACK=false

# Session lifetime (days). Default 30.
# SESSION_TTL_DAYS=30

# Name of the session cookie. Default 'fa_session'.
# SESSION_COOKIE_NAME=fa_session

# ============================================================
# Reverse proxy / TLS
# ============================================================

# When the server sits behind Railway/Caddy/nginx with TLS termination.
# HTTPS_TERMINATED=true

# Read X-Forwarded-For for the correct client IP in rate limiting. Set
# only when the server is behind a trusted reverse proxy
# (Railway, Cloudflare, Caddy).
# TRUST_PROXY=true

# ============================================================
# Sentry (phase 17, optional)
# ============================================================
# If SENTRY_DSN is missing, @sentry/node is never loaded — zero runtime cost.
# SENTRY_DSN=https://xxx@oNN.ingest.sentry.io/NNN
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=1.3.0

# ============================================================
# Railway-specific
# ============================================================
# Railway mounts the volume at /data by definition. The Docker image
# expects /app/data (see Dockerfile), so either (a) mount the volume at
# /app/data in the Railway UI, or (b) override DB_PATH here.
# DB_PATH=/app/data/familieassistenten.db
# BACKUP_REMOTE_PATH can point to an rclone-configured B2 remote, e.g.
# rsync to a sidecar volume. See DEPLOY.md §"Deploy on Railway".
