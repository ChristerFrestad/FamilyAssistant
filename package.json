{
  "name": "familieassistenten",
  "version": "1.3.0-alpha.2",
  "description": "Selvforbedrende husholdsassistent for familien Frestad — kjører lokalt på Raspberry Pi 5",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:fallback": "LLM_BACKEND=ollama node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec tests/*.test.js",
    "test:coverage:gate": "node --test --experimental-test-coverage --test-reporter=spec tests/*.test.js | node scripts/coverage-gate.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"server/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"public/sw.js\" \"public/manifest.json\" \"package.json\"",
    "format:fix": "prettier --write \"server/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"public/sw.js\" \"public/manifest.json\" \"package.json\"",
    "ci": "npm run lint && npm run format && npm test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sbom": "cyclonedx-npm --omit dev --package-lock-only --output-format JSON --output-file sbom.json",
    "sbom:full": "cyclonedx-npm --package-lock-only --output-format JSON --output-file sbom-full.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "globals": "^15.14.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3"
  },
  "keywords": [
    "familieassistenten",
    "raspberry-pi",
    "sqlite",
    "llm",
    "husholdning"
  ],
  "author": "Christer & Martine Frestad",
  "license": "MIT"
}
