{
  "name": "familyassistant",
  "version": "1.3.0",
  "description": "Self-improving household assistant — runs locally on a Raspberry Pi 5",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.0.0 <23",
    "npm": ">=10.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "scripts": {
    "start": "node server/index.js",
    "start:fallback": "LLM_BACKEND=ollama node server/index.js",
    "test": "node scripts/run-tests.js",
    "test:watch": "node scripts/run-tests.js --watch",
    "test:coverage": "node scripts/run-tests.js --experimental-test-coverage --test-reporter=spec",
    "test:coverage:gate": "node scripts/run-tests.js --experimental-test-coverage --test-reporter=spec | node scripts/coverage-gate.js",
    "test:client": "vitest run --config client/vitest.config.ts --passWithNoTests",
    "test:client:watch": "vitest --config client/vitest.config.ts",
    "test:client:coverage": "vitest run --coverage --config client/vitest.config.ts --passWithNoTests",
    "test:llm": "node --test tests/llm-integration.opt-in.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"server/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"public/sw.js\" \"package.json\"",
    "format:fix": "prettier --write \"server/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"public/sw.js\" \"package.json\"",
    "ci": "npm run lint && npm run format && npm test && npm run test:client",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sbom": "cyclonedx-npm --omit dev --package-lock-only --output-format JSON --output-file sbom.json",
    "sbom:full": "cyclonedx-npm --package-lock-only --output-format JSON --output-file sbom-full.json",
    "typecheck": "tsc --noEmit",
    "openapi:types": "openapi-typescript openapi.yaml --output types/openapi.d.ts",
    "prepare": "husky || true",
    "dev:client": "vite --config client/vite.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "preview:client": "vite preview --config client/vite.config.ts",
    "typecheck:client": "tsc --noEmit --project client/tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "i18next": "26.2.0",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "1.16.0",
    "pino": "^10.3.1",
    "react-i18next": "17.0.8",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@sentry/node": "^8.0.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.8",
    "autoprefixer": "10.5.0",
    "eslint": "10.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "29.1.1",
    "lint-staged": "^17.0.7",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.1.3",
    "postcss": "8.5.15",
    "prettier": "3.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "tailwindcss": "3.4.15",
    "typescript": "^5.9.3",
    "vite": "6.4.2",
    "vitest": "4.1.8"
  },
  "lint-staged": {
    "server/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "scripts/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "public/sw.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "package.json": "prettier --write",
    "client/**/*.{ts,tsx,css}": "prettier --write",
    "client/**/*.{json,html}": "prettier --write"
  },
  "keywords": [
    "familyassistant",
    "household",
    "self-hosted",
    "raspberry-pi",
    "sqlite",
    "llm"
  ],
  "author": "Christer Frestad",
  "license": "MIT"
}
