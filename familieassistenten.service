# Systemd service unit for FamilyAssistant
# Install: sudo cp familieassistenten.service /etc/systemd/system/
#          sudo systemctl enable familieassistenten
#          sudo systemctl start familieassistenten
#
# Filename is intentionally kept as familieassistenten.service to avoid
# breaking existing installs that already reference this unit. The
# Description field below renders the brand name as it shows in
# `systemctl status` and journalctl output.

[Unit]
Description=FamilyAssistant — self-hosted household assistant
After=network.target
Wants=network-online.target

[Service]
# M2.2: notify type makes systemd wait for READY=1 from the process
# before marking it started; WatchdogSec triggers a restart if
# WATCHDOG=1 is not sent within the timeout.
Type=notify
NotifyAccess=main
WatchdogSec=90
User=pi
WorkingDirectory=/home/pi/FamilyAssistant
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5
# Limit restart storms: max 5 restarts per 60s, then give up
StartLimitIntervalSec=60
StartLimitBurst=5

Environment=NODE_ENV=production
Environment=PORT=7777
Environment=OLLAMA_HOST=http://localhost:11434
Environment=OLLAMA_MODEL=qwen3:4b
# Remember to set AUTH_TOKEN and ALLOWED_ORIGINS here (see DEPLOY.md §13.4)
# and HTTPS_TERMINATED=true when running behind Caddy.

# M2.1: off-site backup (optional). Set to NAS mount, user@host:/path, or rsync://host/module
# Environment=BACKUP_REMOTE_PATH=/mnt/nas/familyassistant

# Security hardening (systemd sandboxing)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/home/pi/FamilyAssistant/data /home/pi/FamilyAssistant/.env
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
